# Copy to .env. Never commit real keys.
JWT_SECRET=generate-a-long-random-string
DATABASE_URL=sqlite:///./lumetra.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/lumetra   (pip install "psycopg[binary]")

# LLM: offline (demo, no key) | anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=offline
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Speech / pronunciation (see docs/PRONUNCIATION.md). browser = free, no phoneme control.
TTS_PROVIDER=browser
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_MALE=
TTS_PHONEMES=auto

GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_URL=http://localhost:5173
